c:["$","h2",null,{"children":"Why we use it"}]
d:["$","ul",null,{"children":[["$","li",null,{"children":"to give you the book you bought and keep your place in it (to perform our contract with you);"}],["$","li",null,{"children":"to take payment, send receipts and handle refunds (contract, and our legal duty to keep financial records);"}],["$","li",null,{"children":"to prevent fraud, unauthorised sharing and copying of the book (our legitimate interest in protecting our work);"}],["$","li",null,{"children":"to tell you when a new part or a revised edition of your investigation is released (contract);"}],["$","li",null,{"children":"to tell you about new investigations, only if you agree. You can stop these at any time from any such email."}]]}]
e:["$","p",null,{"children":"We do not sell your data, and we do not use it for advertising profiles."}]
f:["$","h2",null,{"children":"Who we share it with"}]
10:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Flutterwave"}],", and any other licensed processor we use such as Paystack, to process payments and refunds;"]}],["$","li",null,{"children":[["$","strong",null,{"children":"our hosting and email providers"}],", who store and send data for us under contract and only on our instructions;"]}],["$","li",null,{"children":[["$","strong",null,{"children":"authorities"}],", only when the law requires it."]}]]}]
11:["$","p",null,{"children":"Some of these providers keep data outside Nigeria. When data leaves Nigeria, or the EU or UK, we rely on the safeguards the law requires, such as adequacy decisions or standard contractual clauses."}]
12:["$","h2",null,{"children":"How long we keep it"}]
13:["$","p",null,{"children":"Your account and reading place: for as long as you have the account, since your access is for life. Purchase records: six years, as tax law requires. Technical logs: up to 12 months. When you close your account, we delete your data except what the law requires us to keep."}]
14:["$","h2",null,{"children":"On your device"}]
15:["$","p",null,{"children":"The app stores small files on your device so it can work offline, remember your settings and keep you signed in. These are needed for the app to work. We use no advertising cookies."}]
16:["$","h2",null,{"children":"Your rights"}]
17:["$","p",null,{"children":"You may ask to see the data we hold about you, correct it, delete it, receive a copy of it, or object to or limit how we use it, and you may withdraw any consent you gave. Email us and we will answer within 30 days. If you are not satisfied, you may complain to the Nigeria Data Protection Commission, or to the data protection authority where you live."}]
18:["$","h2",null,{"children":"Children"}]
19:["$","p",null,{"children":["The Laws of Ruin"," is not directed at children under 13, and we do not knowingly collect their data. A buyer under 18 should have a parent or guardian's permission."]}]
1a:["$","h2",null,{"children":"Security"}]
1b:["$","p",null,{"children":"All traffic to the app is encrypted. Access to our data is limited to the people who need it. If a breach ever puts your data at risk, we will tell you and the regulator as the law requires."}]
1c:["$","h2",null,{"children":"Changes and contact"}]
1d:["$","p",null,{"children":["We will post any change here and update the date at the top; significant changes will also be emailed to you. Questions or requests: ",["$","a",null,{"href":"mailto:lawofruin@gmail.com","children":"lawofruin@gmail.com"}],"."]}]
