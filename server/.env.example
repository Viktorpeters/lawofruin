# Copy this file to .env and fill in every value. Never commit .env.

PORT=4000
NODE_ENV=development

# PostgreSQL on Neon. In Neon: Connect, copy the address twice.
# DATABASE_URL: with Connection pooling ON (the host has -pooler in it).
# DIRECT_URL:   with Connection pooling OFF (no -pooler).
# End both with ?sslmode=require&connect_timeout=30 (the wait lets a sleeping database wake up).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

# A long random string, at least 32 characters. It signs every sign-in.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Where the website lives, and where this server lives (live values).
# On your own computer, use APP_URL=http://localhost:3000 and API_URL=http://localhost:4000.
APP_URL=https://lawofruin.app
API_URL=https://api.lawofruin.app
# Websites allowed to call this server, separated by commas.
CORS_ORIGINS=https://lawofruin.app,https://www.lawofruin.app,http://localhost:3000

# Brevo: brevo.com, SMTP and API, API keys. Authenticate the domain lawofruin.app in Brevo
# (Senders, Domains) so mail from noreply@lawofruin.app lands in the inbox, not spam.
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@lawofruin.app
MAIL_FROM_NAME=The Laws of Ruin

# Anthropic: console.anthropic.com, API keys. Used by Ask and by the translation script.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-haiku-5-5
TRANSLATE_MODEL=claude-sonnet-5-5

# Emails that can read every part before it is released, to proofread. Separate with commas.
PREVIEW_EMAILS=
