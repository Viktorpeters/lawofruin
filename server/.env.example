# Copy this file to .env and fill in every value. Never commit .env.

PORT=4000
NODE_ENV=development

# PostgreSQL. A free database from neon.tech works: copy its connection string here.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# A long random string, at least 32 characters. It signs every sign-in.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Where the website lives, and where this server lives (live values).
# On your own computer, use APP_URL=http://localhost:3000 and API_URL=http://localhost:4000.
APP_URL=https://lawofruin.io
API_URL=https://api.lawofruin.app
# Websites allowed to call this server, separated by commas.
CORS_ORIGINS=https://lawofruin.io,https://www.lawofruin.io,http://localhost:3000

# Brevo: brevo.com, SMTP and API, API keys. The sender address must be verified in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=lawofruin@gmail.com
MAIL_FROM_NAME=The Laws of Ruin

# Anthropic: console.anthropic.com, API keys. Used by Ask and by the translation script.
ANTHROPIC_API_KEY=
ASK_MODEL=claude-haiku-5-5
TRANSLATE_MODEL=claude-sonnet-5-5

# Emails that can read every part before it is released, to proofread. Separate with commas.
PREVIEW_EMAILS=
